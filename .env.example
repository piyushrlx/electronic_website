# TechFusion Environment Configuration Template
APP_NAME=TechFusion
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/electronic_website/public

# Database Configuration (Default XAMPP / Hosted MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=electronic_store
DB_USERNAME=root
DB_PASSWORD=
DB_SSL_MODE=disabled

# Staging Database (Optional fallback)
DB_STAGING_DATABASE=electronic_store_staging

# Session Management (database or file)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

# Security & Encryption Key
APP_KEY=base64:7vF8s3K2rA9bC1dE4fG5hI6jK7lM8nO9pQ0rS1tU2vW=

# Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID=rzp_test_sampleKey12345
RAZORPAY_KEY_SECRET=rzp_test_sampleSecret67890
PAYMENT_MODE=test

# Email & Notifications (SMTP)
MAIL_DRIVER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_NAME="TechFusion Store"
MAIL_FROM_ADDRESS=support@techfusion.com
